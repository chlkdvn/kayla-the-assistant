# Kayla's private local configuration. Copy this file to `.env` and fill it in
# (or just run `uv run kayla-setup`, which writes `.env` for you). NEVER commit `.env`
# or a real key — this file holds placeholders only.

# ── Her brain ────────────────────────────────────────────────────────────────
# "gemini" = Google Gemini Live: cheaper audio, free key, the recommended choice.
# "openai" = OpenAI gpt-realtime (needs OPENAI_API_KEY below).
KAYLA_REALTIME_PROVIDER=gemini

# Required for the Gemini brain. Get a FREE key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Only used for long-term memory and the older push-to-talk voice mode.
# Leave blank on a Gemini setup — she just runs without memory until you add one.
OPENAI_API_KEY=

KAYLA_NAME=Kayla

# ── Gemini voice ─────────────────────────────────────────────────────────────
KAYLA_GEMINI_REALTIME_MODEL=gemini-3.1-flash-live-preview
# Voices: Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr.
KAYLA_GEMINI_VOICE=Leda
KAYLA_GEMINI_AFFECTIVE_DIALOG=false
KAYLA_TONE_CUES_ENABLED=true

# ── Audio ────────────────────────────────────────────────────────────────────
# Leave blank for system defaults. Run `uv run python -m sounddevice` to list devices.
KAYLA_AUDIO_INPUT_DEVICE=
KAYLA_AUDIO_OUTPUT_DEVICE=
# Half-duplex mutes the mic while she talks (stops her hearing her own echo). Keep true
# unless you use headphones and want to interrupt her by voice.
KAYLA_REALTIME_HALF_DUPLEX=true
KAYLA_REALTIME_ECHO_CANCEL=false

# ── Vision (camera) ──────────────────────────────────────────────────────────
# She only takes a photo when she calls her `look` tool. Degrades gracefully with no camera.
KAYLA_VISION_ENABLED=true
KAYLA_CAMERA_DEVICE=0
KAYLA_VISION_MAX_WIDTH=768

# She can also see your SCREEN via a `see_screen` tool (needs `grim`, a Wayland/wlroots
# screenshot tool). Off by default. Wider = sharper text she can read, but costs more tokens.
KAYLA_SCREEN_ENABLED=false
KAYLA_SCREEN_MAX_WIDTH=1280

# ── Long-term memory ─────────────────────────────────────────────────────────
# Needs an OpenAI key (embeddings). Auto-disabled if OPENAI_API_KEY is blank.
KAYLA_MEMORY_ENABLED=true
KAYLA_MEMORY_AUTO_CAPTURE=true
KAYLA_MEMORY_PATH=kayla_memory.json
KAYLA_MEMORY_TOP_K=5

# ── Wake word ────────────────────────────────────────────────────────────────
# Say "Kayla, pay attention" to wake, "Kayla, at ease" to sleep. Off by default because it
# needs a local Vosk model — `uv run kayla-setup` can download it and switch this on.
KAYLA_WAKE_ENABLED=false
KAYLA_WAKE_BACKEND=vosk
KAYLA_WAKE_VOSK_MODEL_PATH=
KAYLA_WAKE_PHRASES_SLEEP=at ease
KAYLA_WAKE_SENSITIVITY=0.5
KAYLA_WAKE_AUTO_SLEEP_SECONDS=90
KAYLA_WAKE_QUICK_SLEEP_SECONDS=30
KAYLA_WAKE_GREETING=Yeah?
KAYLA_WAKE_FAREWELL=Alright, later.

# ── On-screen face ───────────────────────────────────────────────────────────
# The kayla-face window (glowing eyes + mouth). Needs the `face` extra (pygame). Windowed
# by default so it doesn't surprise you with fullscreen.
KAYLA_FACE_ENABLED=true
KAYLA_FACE_AUTOSTART=true
KAYLA_FACE_FULLSCREEN=false
KAYLA_FACE_HOST=127.0.0.1
KAYLA_FACE_PORT=8765

# ── Computer control (OFF by default — she can run commands on this machine) ──
# Browser opening is low risk and on. Shell/keyboard control is powerful; only turn it
# on if you trust this setup. The catastrophic-command tripwire stays on regardless.
KAYLA_BROWSER_ENABLED=true
KAYLA_SHELL_ENABLED=false
KAYLA_SHELL_BLOCK_DANGEROUS=true
KAYLA_SHELL_TIMEOUT_SECONDS=20
KAYLA_KEYBOARD=wtype
KAYLA_TERMINAL=


# ── OpenAI-only extras (text chat `kayla` and push-to-talk `kayla-voice`) ─────────
# These modes always use OpenAI; ignored on a Gemini-only setup.
KAYLA_OPENAI_MODEL=gpt-5.4-mini
KAYLA_EMBEDDING_MODEL=text-embedding-3-small
