# Kayla's private local configuration. Copy this file to `.env` and fill it in
# (or just run `uv run kayla-setup`, which writes `.env` for you). NEVER commit `.env`
# or a real key — this file holds placeholders only.

# ── Her brains ───────────────────────────────────────────────────────────────
# Voice (realtime speech): Google Gemini Live — free key, cheaper audio.
# Get a FREE key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chat, push-to-talk voice, wake greetings: Groq (OpenAI-compatible, free key).
# Get a FREE key at https://console.groq.com/keys
GROQ_API_KEY=
# Rarely needed: point at a different OpenAI-compatible endpoint.
# KAYLA_GROQ_BASE_URL=https://api.groq.com/openai/v1

KAYLA_NAME=Kayla

# ── Gemini voice ─────────────────────────────────────────────────────────────
KAYLA_GEMINI_REALTIME_MODEL=gemini-3.1-flash-live-preview
# Voices: Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr.
KAYLA_GEMINI_VOICE=Leda
KAYLA_GEMINI_AFFECTIVE_DIALOG=false
KAYLA_TONE_CUES_ENABLED=true

# ── Audio ────────────────────────────────────────────────────────────────────
# Leave blank for system defaults. Run `uv run python -m sounddevice` to list devices.
KAYLA_AUDIO_INPUT_DEVICE=
KAYLA_AUDIO_OUTPUT_DEVICE=
# Half-duplex mutes the mic while she talks (stops her hearing her own echo). Keep true
# unless you use headphones and want to interrupt her by voice.
KAYLA_REALTIME_HALF_DUPLEX=true
KAYLA_REALTIME_ECHO_CANCEL=false
# How long silence before she considers your turn finished (milliseconds).
KAYLA_REALTIME_VAD_SILENCE_MS=450

# ── Vision (camera) ──────────────────────────────────────────────────────────
# She only takes a photo when she calls her `look` tool. Degrades gracefully with no camera.
KAYLA_VISION_ENABLED=true
KAYLA_CAMERA_DEVICE=0
KAYLA_VISION_MAX_WIDTH=768

# She can also see your SCREEN via a `see_screen` tool (needs `grim`, a Wayland/wlroots
# screenshot tool). On by default — "can you see my screen" should just work.
# Wider = sharper text she can read, but costs more tokens.
KAYLA_SCREEN_ENABLED=true
KAYLA_SCREEN_MAX_WIDTH=1280

# ── Speaker loudness ─────────────────────────────────────────────────────────
# Trim applied to Kayla's voice before playback (1.0 = untouched). Peaks are
# always soft-limited so she never blasts the laptop speakers.
KAYLA_SPEAKER_GAIN=0.8

# ── Long-term memory ─────────────────────────────────────────────────────────
# Runs entirely locally (fastembed embeddings) — no key, no network at recall time.
KAYLA_MEMORY_ENABLED=true
KAYLA_MEMORY_AUTO_CAPTURE=true
KAYLA_MEMORY_PATH=kayla_memory.json
KAYLA_MEMORY_TOP_K=5

# ── Wake word ────────────────────────────────────────────────────────────────
# Say "Kayla, pay attention" to wake, "Kayla, at ease" to sleep. Off by default because it
# needs a local Vosk model — `uv run kayla-setup` can download it and switch this on.
KAYLA_WAKE_ENABLED=false
KAYLA_WAKE_BACKEND=vosk
KAYLA_WAKE_VOSK_MODEL_PATH=
KAYLA_WAKE_PHRASES_SLEEP=at ease
KAYLA_WAKE_SENSITIVITY=0.5
KAYLA_WAKE_AUTO_SLEEP_SECONDS=90
KAYLA_WAKE_QUICK_SLEEP_SECONDS=30
KAYLA_WAKE_GREETING=Yeah?
KAYLA_WAKE_FAREWELL=Alright, later.

# ── On-screen face ───────────────────────────────────────────────────────────
# The kayla-face window (glowing eyes + mouth). Needs the `face` extra (pygame). Windowed
# by default so it doesn't surprise you with fullscreen.
KAYLA_FACE_ENABLED=true
KAYLA_FACE_AUTOSTART=true
KAYLA_FACE_FULLSCREEN=false
KAYLA_FACE_HOST=127.0.0.1
KAYLA_FACE_PORT=8765

# ── The floating orb (the 3D pop-out) ────────────────────────────────────────
# Kayla's own always-on-top mini window: draggable, movable by voice, remembers
# where it sat, and shows the start-of-session choice chips. When it is on it
# REPLACES the face window in realtime mode.
KAYLA_ORB_ENABLED=true
KAYLA_ORB_AUTOSTART=true
KAYLA_ORB_HOST=127.0.0.1
KAYLA_ORB_PORT=8766
KAYLA_ORB_WIDTH=420
KAYLA_ORB_HEIGHT=260
KAYLA_ORB_OPACITY=0.96

# ── Laptop control tools ─────────────────────────────────────────────────────
# Laptop awareness and actions: what's open, RAM/CPU/battery, opening any installed
# app, closing/focusing windows, tiling the screen (split into 2/3/4), GNOME focus
# (notifications off) and power profiles (best performance). Uses psutil + wmctrl.
KAYLA_SYSTEM_TOOLS_ENABLED=true

# ── Phone bridge (paired iPhone on the same Wi-Fi) ───────────────────────────
# A local HTTP server your phone's Shortcut polls for focus commands. The recipe
# lives in docs/devices.md. Storage keeps paired tokens between restarts.
KAYLA_DEVICES_ENABLED=true
KAYLA_DEVICES_PORT=8711
KAYLA_DEVICES_PATH=kayla_devices.json

# ── Computer control (OFF by default — she can run commands on this machine) ──
# Browser opening is low risk and on. Shell/keyboard control is powerful; only turn it
# on if you trust this setup. The catastrophic-command tripwire stays on regardless.
KAYLA_BROWSER_ENABLED=true
KAYLA_SHELL_ENABLED=false
KAYLA_SHELL_BLOCK_DANGEROUS=true
KAYLA_SHELL_TIMEOUT_SECONDS=20
KAYLA_KEYBOARD=wtype
KAYLA_TERMINAL=


# ── Groq models (text chat `kayla`, push-to-talk `kayla-voice`, seeding) ──────
KAYLA_CHAT_MODEL=openai/gpt-oss-120b
KAYLA_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Groq's TTS accepts up to 200 characters per request; Kayla chunks longer replies.
# NOTE: accept the model's terms once at https://console.groq.com/playground
# Voices: autumn, diana, hannah (F); austin, daniel, troy (M).
KAYLA_SPEECH_MODEL=canopylabs/orpheus-v1-english
KAYLA_SPEECH_VOICE=hannah
# Local embedding model for long-term memory (fastembed).
KAYLA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
